{
  "id": "layout_doc",
  "name": "文档 + 文件 + 保留位 + AI",
  "description": "左侧宽文档阅读区、右上文件、下方工具位、右下 AI。复盘 / 周报 / 长文阅读最舒服。",
  "layout": "grid",
  "theme": "dark",
  "panels": [
    {
      "id": "dc-doc",
      "title": "文档",
      "sub": "点文件里的 md / pdf 即在此阅读",
      "type": "view",
      "col": 1,
      "row": 1,
      "w": 3,
      "h": 3
    },
    {
      "id": "dc-file",
      "title": "文件",
      "type": "file",
      "col": 4,
      "row": 1,
      "w": 1,
      "h": 3
    },
    {
      "id": "dc-extra",
      "title": "工具位",
      "sub": "换成网页 / 清单 / 图表",
      "type": "reserved",
      "col": 1,
      "row": 4,
      "w": 2,
      "h": 2
    },
    {
      "id": "dc-ai",
      "title": "AI",
      "type": "harness",
      "col": 3,
      "row": 4,
      "w": 2,
      "h": 2
    }
  ]
}
